# Production build allow-list for the PATCHWORK editor iframe bridge.
# Comma-separated exact origins (no trailing slash). Empty/unset disables the
# selection runtime entirely on the deployed site.
VITE_PATCHWORK_PARENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174